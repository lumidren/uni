# Copy to .env and adjust. NONE of these are required for the offline demo
# against the bundled mock target.

# Target to attack. MUST be on the allowlist (loopback / approved lab subnet).
TARGET_URL=http://127.0.0.1:3000

# Allowlist config (adds approved private lab subnets; public ranges always refused).
ALLOWLIST_CONFIG=config/allowlist.json

# Inbound GRC context (CNC 419). If unreachable, falls back to the mock file below.
GRC_API_URL=http://127.0.0.1:4190
GRC_ASSETS_MOCK=../integration/mock_payloads/assets_profile.json

# Outbound: where to publish verified findings (Blue Team CNC 411 / GRC CNC 419).
BLUE_API_URL=http://127.0.0.1:4110
PUBLISH_FINDINGS=false

# Optional pluggable LLM planner backend. Leave blank to use the deterministic planner.
LLM_API_KEY=
LLM_MODEL=

# Noise / self-DoS guards.
MAX_REQUESTS=800
MIN_REQUEST_INTERVAL_S=0.15
