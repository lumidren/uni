# Copy to .env and adjust. None are required for the offline walkthrough.

# Bridge API bind port (loopback only).
GRC_API_PORT=4190

# Asset register published to Red/Blue.
ASSETS_FILE=data/assets.json

# Optional LLM/RAG backend for ingestion + mapping narration.
LLM_API_KEY=
LLM_MODEL=

# Optional dense-retrieval backend (else the built-in TF-IDF retriever is used).
VECTOR_DB_URL=
