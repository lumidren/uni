# Copy to .env and adjust. None are required for the offline demo.

# Inbound GRC asset profiles (weights severity + approval). Falls back to a
# built-in synthetic asset index if unset.
GRC_API_URL=http://127.0.0.1:4190
GRC_ASSETS_MOCK=../integration/mock_payloads/assets_profile.json

# Red Team findings to correlate against (by exercise_run_id / X-Exercise-Run-ID).
RED_FINDINGS=data/mock_red_findings.json

# Scenario file to replay.
SCENARIOS=data/scenarios.json

# If set (e.g. ciso@lab), held high-impact actions are approved+executed.
# Leave blank to HOLD them (human-in-the-loop demonstration).
APPROVER=

# Where to publish incident KPIs (GRC CNC 419).
GRC_INCIDENTS_URL=http://127.0.0.1:4190
PUBLISH_INCIDENTS=false
